{
  "name": "arqcdr",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server-azure.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && npx -y esbuild server-azure.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --external:express --external:vite --external:@azure/* --external:openai --external:jwks-rsa --external:jsonwebtoken",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:azure": "powershell ./scripts/setup-azure.ps1",
    "setup:azure:existing": "powershell ./scripts/setup-existing-azure.ps1"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.1",
    "@azure/identity": "^4.0.1",
    "@azure/keyvault-secrets": "^4.8.0",
    "@azure/msal-browser": "^3.27.0",
    "@azure/msal-node": "^2.16.2",
    "@azure/storage-blob": "^12.24.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^5.10.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.184.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.14.0",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.21",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^2.1.9"
  }
}
