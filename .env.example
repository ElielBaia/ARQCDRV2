# ===========================================================================
# ARQCdR // Azure Configuration Template
# Copy this file to .env.local and fill in real values from your Azure portal.
# Never commit .env.local to git.
# ===========================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# ---- Azure Cosmos DB (project persistence) ----
AZURE_COSMOS_CONNECTION_STRING=
AZURE_COSMOS_DATABASE=arqcdr-db
AZURE_COSMOS_CONTAINER=projects

# ---- Azure Blob Storage (exports, snapshots) ----
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=exports

# ---- Azure OpenAI (semantic BIM compiler) ----
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Azure Entra ID (authentication) ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback
# Audience claim expected in incoming access tokens (defaults to AZURE_CLIENT_ID).
AZURE_TOKEN_AUDIENCE=

# ---- Frontend (Vite-exposed; prefixed with VITE_) ----
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:3000
VITE_AZURE_API_SCOPE=
VITE_API_BASE=
